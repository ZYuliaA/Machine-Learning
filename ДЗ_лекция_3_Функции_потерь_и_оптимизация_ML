      "source": [
        "def log_loss(y, y_pred):\n",
        "  class_1 = np.sum(np.log(y_pred[y==1] + 1e-30))\n",
        "  class_0 = np.sum(np.log(1 - y_pred[y==0] + 1e-30))\n",
        "  return -(class_1 + class_0) / len(y)"
